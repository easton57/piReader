[Unit]
Description=piReader
After=network.target pisugar-server.service
Wants=pisugar-server.service

[Service]
# Adjust paths if you cloned somewhere else.
ExecStart=/home/pi/piReader/venv/bin/python /home/pi/piReader/main.py
WorkingDirectory=/home/pi/piReader
Restart=on-failure
RestartSec=5
User=pi
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
